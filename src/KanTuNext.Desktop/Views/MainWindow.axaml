<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KanTuNext.Desktop.ViewModels"
        xmlns:views="clr-namespace:KanTuNext.Desktop.Views"
        xmlns:services="clr-namespace:KanTuNext.Desktop.Services"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KanTuNext.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="看图" Icon="/Assets/kantunext.png"
        Width="1200" Height="650" MinWidth="820" MinHeight="480" WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        WindowDecorations="Full"
        FontSize="13">
  <Window.Styles>
    <!-- Opaque unless the platform gives the window a blurred backdrop: then only the sidebar lets it through -->
    <Style Selector="views|MainWindow">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    </Style>
    <Style Selector="views|MainWindow.translucent">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="views|MainWindow.translucent Border#Sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarTranslucentBrush}" />
    </Style>
    <!-- Sidebar edge: a hairline with a wider invisible grip -->
    <Style Selector="GridSplitter#SidebarSplitter">
      <Setter Property="Width" Value="7" />
      <Setter Property="Margin" Value="0,0,-3,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource SidebarBorderBrush}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <!-- macOS menu bar, after the application menu in App.axaml -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="文件">
        <NativeMenu>
          <NativeMenuItem Header="添加常用文件夹…" Gesture="Cmd+O" Click="OnAddFolderMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="关闭窗口" Gesture="Cmd+W" Click="OnCloseMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="显示">
        <NativeMenu>
          <NativeMenuItem Header="小" Gesture="Cmd+D1" ToggleType="Radio" IsChecked="{Binding IsSmall}" Click="OnSizeMenu" />
          <NativeMenuItem Header="中" Gesture="Cmd+D2" ToggleType="Radio" IsChecked="{Binding IsMedium}" Click="OnSizeMenu" />
          <NativeMenuItem Header="大" Gesture="Cmd+D3" ToggleType="Radio" IsChecked="{Binding IsLarge}" Click="OnSizeMenu" />
          <NativeMenuItem Header="最大" Gesture="Cmd+D4" ToggleType="Radio" IsChecked="{Binding IsLargest}" Click="OnSizeMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding SidebarMenuText}" Gesture="Cmd+Ctrl+S" Click="OnToggleSidebarMenu" />
          <NativeMenuItem Header="找图" Gesture="Cmd+F" Click="OnFindMenu" />
          <NativeMenuItem Header="显示简介" Gesture="Cmd+I" IsEnabled="{Binding HasSelection}" Click="OnInfoMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="照片">
        <NativeMenu>
          <NativeMenuItem Header="打开" Gesture="Cmd+Down" IsEnabled="{Binding HasSelection}" Click="OnOpenMenu" />
          <NativeMenuItem Header="在访达中显示" Gesture="Cmd+Shift+R" IsEnabled="{Binding HasSelection}" Click="OnRevealMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="标记为「好」" IsEnabled="{Binding HasSelection}" Click="OnTagGoodMenu" />
          <NativeMenuItem Header="标记为「中」" IsEnabled="{Binding HasSelection}" Click="OnTagNeutralMenu" />
          <NativeMenuItem Header="标记为「差」" IsEnabled="{Binding HasSelection}" Click="OnTagBadMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="移到废纸篓" Gesture="Cmd+Back" IsEnabled="{Binding HasSelection}" Click="OnTrashMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="窗口">
        <NativeMenu>
          <NativeMenuItem Header="最小化" Gesture="Cmd+M" Click="OnMinimizeMenu" />
          <NativeMenuItem Header="缩放" Click="OnZoomMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="帮助">
        <NativeMenu>
          <NativeMenuItem Header="看图主页" Click="OnHomePageMenu" />
          <NativeMenuItem Header="检查更新…" Click="OnCheckUpdatesMenu" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <!-- 1200×650 window, 32pt rows, 52pt toolbar; the sidebar defaults to Finder's width and can be dragged -->
  <Grid x:Name="Layout" chrome:WindowDecorationProperties.ElementRole="User">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" MinWidth="160" MaxWidth="400" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <DockPanel>
        <!-- Traffic lights / drag area above the list; the toggle stays on the sidebar side of its divider -->
        <Border DockPanel.Dock="Top" Height="44" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
          <Button x:Name="SidebarToggle" Classes="toolIcon" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,10,0" ToolTip.Tip="{Binding SidebarMenuText}" Click="OnToggleSidebar"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <PathIcon Data="{StaticResource Icon.dock-left}" Width="18" Height="18" />
          </Button>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarSection">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="20,12,20,4">
                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarHeaderBrush}" />
                    <Button Grid.Column="1" Classes="toolIcon" Padding="2" IsVisible="{Binding CanAdd}"
                            ToolTip.Tip="添加文件夹" Click="OnAddFolder">
                      <PathIcon Data="{StaticResource Icon.plus}" Width="12" Height="12"
                                Foreground="{DynamicResource SidebarHeaderBrush}" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SidebarItem">
                        <RadioButton Classes="sidebarItem" GroupName="sidebar" IsChecked="{Binding IsSelected}">
                          <Grid ColumnDefinitions="14,6,16,9,*,Auto" Margin="{Binding Indent}">
                            <Button Classes="chevron" IsVisible="{Binding Expandable}" Click="OnToggleFolder"
                                    ToolTip.Tip="展开子文件夹">
                              <PathIcon Data="{StaticResource Icon.chevron-right}" Width="12" Height="12"
                                        Foreground="{DynamicResource SidebarHeaderBrush}">
                                <PathIcon.RenderTransform>
                                  <RotateTransform Angle="{Binding ChevronAngle}" />
                                </PathIcon.RenderTransform>
                              </PathIcon>
                            </Button>
                            <PathIcon Grid.Column="2" Data="{Binding Icon}" Width="16" Height="16"
                                      Foreground="{DynamicResource SidebarIconBrush}" />
                            <TextBlock Grid.Column="4" Text="{Binding Title}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SidebarCountBrush}" />
                          </Grid>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" RowDefinitions="52,*" Background="{DynamicResource PageBrush}">
      <Grid x:Name="Toolbar" Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="24,0,24,0" Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left"
                    chrome:WindowDecorationProperties.ElementRole="User">
          <!-- Only visible while the sidebar is collapsed, when there is no divider to stay left of -->
          <Button x:Name="SidebarCollapsedToggle" Classes="toolIcon" IsVisible="False"
                  ToolTip.Tip="{Binding SidebarMenuText}" Click="OnToggleSidebar">
            <PathIcon Data="{StaticResource Icon.dock-left}" Width="18" Height="18" />
          </Button>
          <Button Classes="toolIcon" IsEnabled="False" ToolTip.Tip="返回">
            <PathIcon Data="{StaticResource Icon.chevron-left}" Width="20" Height="20" />
          </Button>
          <TextBox Width="164" Height="26" MinHeight="26" Padding="4,3" FontSize="12" CornerRadius="6"
                   x:Name="SearchBox" PlaceholderText="找图" VerticalContentAlignment="Center" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip.Tip="按文件名或日期（2016、2016年6月、6月）筛选">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource Icon.magnify}" Width="14" Height="14" Margin="8,0,0,0"
                        Foreground="{DynamicResource SubTextBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" ClipToBounds="True"
                Background="{DynamicResource SegmentBrush}" BorderBrush="{DynamicResource SegmentBorderBrush}"
                BorderThickness="1" chrome:WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" GroupName="size" Content="小" IsChecked="{Binding IsSmall}" />
            <RadioButton Classes="segment" GroupName="size" Content="中" IsChecked="{Binding IsMedium}" />
            <RadioButton Classes="segment" GroupName="size" Content="大" IsChecked="{Binding IsLarge}" />
            <RadioButton Classes="segment" GroupName="size" Content="最大" IsChecked="{Binding IsLargest}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    HorizontalAlignment="Right" chrome:WindowDecorationProperties.ElementRole="User">
          <Button x:Name="InfoButton" Classes="toolIcon" ToolTip.Tip="简介" IsEnabled="{Binding HasSelection}">
            <PathIcon Data="{StaticResource Icon.information-outline}" Width="18" Height="18" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="photoInfo">
                <ItemsControl ItemsSource="{Binding Info}" Width="300" Margin="4,5">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:InfoRow">
                      <Grid ColumnDefinitions="68,*" ColumnSpacing="10" Margin="6,5">
                        <TextBlock Text="{Binding Label}" FontSize="12" LineHeight="18" Padding="0"
                                   VerticalAlignment="Top" Foreground="#8CFFFFFF" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" LineHeight="18"
                                             Padding="0" VerticalAlignment="Top" TextWrapping="Wrap"
                                             Foreground="#F2FFFFFF" SelectionBrush="#662E9BFF" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="SettingsButton" Classes="toolIcon" ToolTip.Tip="设置" Click="OnSettings">
            <PathIcon Data="{StaticResource Icon.cog-outline}" Width="18" Height="18" />
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasItems}" HorizontalScrollBarVisibility="Disabled">
        <views:ThumbnailGrid x:Name="Grid" Groups="{Binding Groups}" ItemEdge="{Binding ItemEdge}" ItemGap="{Binding ItemGap}"
                             ShowSizes="{Binding ShowSizes}" />
      </ScrollViewer>

      <!-- 重复照片 starts with the original's explanation and an explicit scan -->
      <StackPanel Grid.Row="1" IsVisible="{Binding ShowDuplicateIntro}" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Spacing="10" Margin="0,0,0,60">
        <TextBlock Text="智能识别重复照片" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="一键识别电脑上完全重复的照片，方便批量管理" FontSize="12" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SubTextBrush}" />
        <Button Content="开始扫描" Classes="accent" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="28,7"
                Click="OnScanDuplicates" />
      </StackPanel>

      <TextBlock Grid.Row="1" IsVisible="{Binding DuplicateProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding DuplicateProgress}" FontSize="13" Margin="0,40,0,0"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
      <TextBlock Grid.Row="1" IsVisible="{Binding IsLoading}" Text="正在读取…" FontSize="13"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />

      <!-- Empty state, after the original: dashed photo behind a folder -->
      <StackPanel Grid.Row="1" IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22" Margin="0,0,0,60">
        <Canvas Width="200" Height="176" HorizontalAlignment="Center">
          <Path Stroke="{DynamicResource EmptyArtBrush}" StrokeThickness="1.6" StrokeDashArray="3.75,3.1"
                Data="M48,2 H192 A6,6 0 0 1 198,8 V114 A6,6 0 0 1 192,120 H48 A6,6 0 0 1 42,114 V8 A6,6 0 0 1 48,2 Z" />
          <Ellipse Canvas.Left="74" Canvas.Top="18" Width="32" Height="32" Stroke="{DynamicResource EmptyArtBrush}"
                   StrokeThickness="1.6" StrokeDashArray="3.1,2.5" />
          <Path Stroke="{DynamicResource EmptyArtBrush}" StrokeThickness="1.6" StrokeDashArray="3.75,3.1"
                Data="M118,120 C130,60 180,50 198,88" />
          <Path Stroke="{DynamicResource EmptyArtBrush}" StrokeThickness="1.6" Fill="{DynamicResource PageBrush}"
                StrokeJoin="Round"
                Data="M14,58 H54 L64,70 H146 A6,6 0 0 1 152,76 V164 A8,8 0 0 1 144,172 H20 A8,8 0 0 1 12,164 L2,72 A6,6 0 0 1 8,64 H14 Z" />
        </Canvas>
        <TextBlock Text="{Binding EmptyText}" FontSize="15" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SubTextBrush}" />
      </StackPanel>
    </Grid>

    <!-- Drag to resize the sidebar; on top of the content so its grip overlaps both sides of the edge -->
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                  DragCompleted="OnSidebarResized" />

    <!-- Where the window buttons are on the right: a hamburger in the top-left corner instead of the toolbar
         toggle, staying put while the sidebar slides under it -->
    <Button x:Name="SidebarMenuButton" Grid.ColumnSpan="2" Classes="toolIcon" IsVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,13,0,0"
            ToolTip.Tip="{Binding SidebarMenuText}" Click="OnToggleSidebar"
            chrome:WindowDecorationProperties.ElementRole="User">
      <PathIcon Data="{StaticResource Icon.menu}" Width="18" Height="18" />
    </Button>
  </Grid>
</Window>
