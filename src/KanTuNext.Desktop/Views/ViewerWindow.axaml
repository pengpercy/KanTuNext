<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KanTuNext.Desktop.ViewModels"
        xmlns:views="clr-namespace:KanTuNext.Desktop.Views"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:services="clr-namespace:KanTuNext.Desktop.Services"
        x:Class="KanTuNext.Desktop.Views.ViewerWindow" x:DataType="vm:ViewerViewModel"
        Title="{Binding Title, FallbackValue=看图}" Icon="/Assets/kantunext.png"
        Width="900" Height="600" MinWidth="420" MinHeight="300"
        Background="#000000"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="Full"
        RequestedThemeVariant="Dark">
  <Window.Styles>
    <!-- 18px icons keep MDI's 2-unit strokes near 1.5px: lighter than the glyphs at their 24px design size -->
    <Style Selector="Button.viewerTool">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Tips (names and shortcuts) only once the pointer rests on a button, not while passing over the dock -->
      <Setter Property="ToolTip.ShowDelay" Value="1000" />
    </Style>
    <!-- No hover or press highlight: the dock stays calm under the pointer -->
    <Style Selector="Button.viewerTool:pointerover /template/ ContentPresenter, Button.viewerTool:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
    </Style>
    <Style Selector="Button.viewerTool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4DFFFFFF" />
    </Style>
    <!-- The mark the photo has: its button lights up in the accent colour -->
    <Style Selector="Button.viewerTool.on">
      <Setter Property="Foreground" Value="#FF2E9BFF" />
    </Style>
    <Style Selector="Button.viewerTool.on:pointerover /template/ ContentPresenter, Button.viewerTool.on:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#FF2E9BFF" />
    </Style>
    <!-- 图片信息 panel: small borderless buttons in its header -->
    <Style Selector="Button.panelTool">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ItemCornerRadius}" />
      <Setter Property="ToolTip.ShowDelay" Value="1000" />
      <Setter Property="Foreground" Value="#B3FFFFFF" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.panelTool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.mapLink">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="#1A2E9BFF" />
      <Setter Property="Foreground" Value="#FF5CB2FF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mapLink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#332E9BFF" />
      <Setter Property="Foreground" Value="#FF8CC8FF" />
    </Style>
    <Style Selector="Border#InfoPanel">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>
    <!-- 轮播间隔: the seconds as text, a little wider than an icon -->
    <Style Selector="Button.viewerTool.interval">
      <Setter Property="Width" Value="46" />
    </Style>
    <Style Selector="Border.toolDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#ToolbarDock">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
      </Setter>
    </Style>
  </Window.Styles>
  <!-- macOS menu bar while viewing (the single-key shortcuts stay with the window's key handling) -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="文件">
        <NativeMenu>
          <NativeMenuItem Header="在访达中显示" Gesture="Cmd+Shift+R" Click="OnRevealMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="关闭" Gesture="Cmd+W" Click="OnCloseMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="显示">
        <NativeMenu>
          <NativeMenuItem Header="放大" Gesture="Cmd+OemPlus" Click="OnZoomInMenu" />
          <NativeMenuItem Header="缩小" Gesture="Cmd+OemMinus" Click="OnZoomOutMenu" />
          <NativeMenuItem Header="实际大小" Gesture="Cmd+D1" Click="OnActualSizeMenu" />
          <NativeMenuItem Header="适应窗口" Gesture="Cmd+D0" Click="OnFitMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="向左旋转" Gesture="Cmd+L" Click="OnRotateLeftMenu" />
          <NativeMenuItem Header="向右旋转" Gesture="Cmd+R" Click="OnRotateRightMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="进入全屏幕" Gesture="Cmd+Ctrl+F" Click="OnFullScreenMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding PlayMenuText}" Gesture="Cmd+P" IsEnabled="{Binding CanPlay}" Click="OnSlideshowMenu" />
          <!-- Filled with the intervals in code (BuildIntervalMenus) -->
          <NativeMenuItem Header="轮播间隔" IsEnabled="{Binding CanPlay}">
            <NativeMenu />
          </NativeMenuItem>
          <NativeMenuItem Header="加快轮播" Gesture="Cmd+OemCloseBrackets" Click="OnFasterMenu" />
          <NativeMenuItem Header="减慢轮播" Gesture="Cmd+OemOpenBrackets" Click="OnSlowerMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding FilmstripMenuText}" Gesture="Cmd+B" Click="OnFilmstripMenu" />
          <NativeMenuItem Header="{Binding FilmstripSideMenuText}" Gesture="Cmd+Shift+B" Click="OnSwapFilmstripMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="照片">
        <NativeMenu>
          <NativeMenuItem Header="上一张" Gesture="Cmd+Left" IsEnabled="{Binding CanGoBack}" Click="OnPreviousMenu" />
          <NativeMenuItem Header="下一张" Gesture="Cmd+Right" IsEnabled="{Binding CanGoForward}" Click="OnNextMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="图片信息" Gesture="Cmd+I" Click="OnInfoMenu" />
          <NativeMenuItem Header="复制图片" Click="OnCopyImageMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="识别文字" Gesture="Cmd+T" IsEnabled="{Binding OcrAvailable}" Click="OnOcrMenu" />
          <NativeMenuItem Header="播放实况" IsEnabled="{Binding IsLivePhoto}" Click="OnPlayLiveMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="标记为「好」" Click="OnTagGoodMenu" />
          <NativeMenuItem Header="标记为「中」" Click="OnTagNeutralMenu" />
          <NativeMenuItem Header="标记为「差」" Click="OnTagBadMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="移到废纸篓" Gesture="Cmd+Back" Click="OnTrashMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="窗口">
        <NativeMenu>
          <NativeMenuItem Header="最小化" Gesture="Cmd+M" Click="OnMinimizeMenu" />
          <NativeMenuItem Header="缩放" Click="OnZoomWindowMenu" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid ColumnDefinitions="Auto,*,Auto" chrome:WindowDecorationProperties.ElementRole="User">
  <!-- 预览条 down the left side: its clipping host slides open (Motion.Slide); the strip moves between hosts -->
  <Panel x:Name="StripLeftHost" Grid.Column="0" Width="0" IsVisible="False" ClipToBounds="True" />

  <Grid Grid.Column="1" RowDefinitions="*,Auto">
  <Panel x:Name="StripBottomHost" Grid.Row="1" Height="0" IsVisible="False" ClipToBounds="True">
    <!-- The strip itself: square thumbnails around the current photo, and a switch to the other edge -->
    <Border x:Name="StripPanel" Background="#141416" BorderBrush="#1AFFFFFF">
      <Panel>
        <!-- Above the strip on the left side: the title bar (and macOS traffic lights) -->
        <Border x:Name="StripTitleBar" Height="36" VerticalAlignment="Top" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar" />
        <views:Filmstrip x:Name="Strip" Index="{Binding Index}" />
        <Button x:Name="StripSwap" Classes="panelTool" Click="OnSwapFilmstrip">
          <PathIcon x:Name="StripSwapIcon" Data="{StaticResource Icon.dock-bottom}" Width="14" Height="14" />
        </Button>
      </Panel>
    </Border>
  </Panel>
  <Grid Grid.Row="0">
    <views:ZoomImage x:Name="Viewer" Source="{Binding Image}" TextLines="{Binding OcrLines}" ShowTextOutlines="{Binding ShowOcr}" />

    <TextBlock IsVisible="{Binding ShowError}" Text="无法打开这张图片" Foreground="#99FFFFFF" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Title strip: file name centred over a soft scrim, draggable like a title bar -->
    <Border Height="36" VerticalAlignment="Top" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#73000000" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Button IsVisible="{Binding IsLivePhoto}" Click="OnPlayLive" Padding="8,2" FontSize="11" CornerRadius="9"
                Background="#33FFFFFF" Foreground="White" BorderThickness="0" ToolTip.Tip="播放实况照片的动态部分（L）"
                chrome:WindowDecorationProperties.ElementRole="User">
          <TextBlock Text="◎ 实况" />
        </Button>
        <!-- One line of runs, so the name and the count share a baseline (two blocks fall back to different fonts
             for Chinese names and digits, and sit at different heights) -->
        <TextBlock FontSize="12" VerticalAlignment="Center">
          <Run Text="{Binding Title}" FontWeight="Medium" Foreground="White" />
          <Run Text="{Binding PositionSuffix}" Foreground="#99FFFFFF" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- 图片信息: a translucent card over the photo, refreshed as photos change -->
    <Border x:Name="InfoPanel" IsVisible="{Binding ShowInfo}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,44,14,100" Width="320" CornerRadius="{StaticResource PanelCornerRadius}" ClipToBounds="True"
            Background="#C7141416" BorderBrush="#1FFFFFFF" BorderThickness="1" BoxShadow="0 14 44 0 #80000000">
      <!-- How far the panel was dragged from its place at the top right (drag any blank part of it) -->
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12,6,10" Background="Transparent">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="{Binding Details.Name, FallbackValue=''}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Details.Summary, FallbackValue='正在读取…'}" FontSize="11.5" Foreground="#99FFFFFF" />
            </StackPanel>
            <!-- Tucked into the corner, clear of the title -->
            <Button Grid.Column="1" Classes="panelTool copy" VerticalAlignment="Top" Margin="0,-6,0,0" ToolTip.Tip="复制全部信息" Click="OnCopyDetails">
              <Panel>
                <PathIcon Classes="copyGlyph" Data="{StaticResource Icon.content-copy}" Width="12" Height="12" />
                <PathIcon Classes="checkGlyph" Data="{StaticResource Icon.check}" Width="14" Height="14" />
              </Panel>
            </Button>
            <Button Grid.Column="2" Classes="panelTool" VerticalAlignment="Top" Margin="0,-6,0,0" ToolTip.Tip="关闭（I）" Click="OnInfo">
              <PathIcon Data="{StaticResource Icon.close}" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,0,12,14" Spacing="14">
            <!-- Camera and exposure at a glance -->
            <Border IsVisible="{Binding Details.HasCamera, FallbackValue=False}" CornerRadius="{StaticResource CardCornerRadius}" Padding="12"
                    Background="#12FFFFFF">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Width="32" Height="32" CornerRadius="6" Background="#262E9BFF" VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource Icon.camera-iris}" Width="17" Height="17" Foreground="#FF5CB2FF" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Details.Camera, TargetNullValue='未知相机', FallbackValue=''}" FontSize="13"
                               FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details.Lens, FallbackValue=''}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap"
                               IsVisible="{Binding Details.Lens, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Details.Exposure, FallbackValue={x:Null}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border CornerRadius="4" Padding="7,2" Background="#1AFFFFFF">
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="#F2FFFFFF" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Details.Sections, FallbackValue={x:Null}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:DetailSection">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#80FFFFFF" Margin="6,0,0,0" />
                    <Border CornerRadius="{StaticResource CardCornerRadius}" Background="#0DFFFFFF" Padding="12,4">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="services:InfoRow">
                            <!-- Same line height, no padding, both top-aligned: label and value share a baseline -->
                            <Grid ColumnDefinitions="78,*" ColumnSpacing="10" Margin="0,5">
                              <TextBlock Text="{Binding Label}" FontFamily="{StaticResource InfoRowFont}" FontSize="12" LineHeight="18"
                                         Padding="0" VerticalAlignment="Top" Foreground="#8CFFFFFF" />
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource InfoRowFont}"
                                                   FontSize="12" LineHeight="18" Padding="0" VerticalAlignment="Top" TextWrapping="Wrap"
                                                   Foreground="#F2FFFFFF" SelectionBrush="#662E9BFF" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="mapLink" Click="OnOpenMap"
                    IsVisible="{Binding Details.MapUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.map-marker-outline}" Width="14" Height="14" />
                <TextBlock Text="在地图中查看拍摄位置" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Floating toolbar, after the original: shown while the pointer moves, hidden after a short pause -->
    <Border x:Name="ToolbarDock" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
            Background="#D91C1C1E" CornerRadius="{StaticResource PanelCornerRadius}" Padding="6"
            BorderBrush="#14FFFFFF" BorderThickness="1" BoxShadow="0 8 28 0 #59000000">
      <StackPanel Orientation="Horizontal">
        <Button Classes="viewerTool" ToolTip.Tip="上一张（←）" Click="OnPrevious" IsEnabled="{Binding CanGoBack}">
          <PathIcon Data="{StaticResource Icon.chevron-left}" Width="20" Height="20" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="下一张（→）" Click="OnNext" IsEnabled="{Binding CanGoForward}">
          <PathIcon Data="{StaticResource Icon.chevron-right}" Width="20" Height="20" />
        </Button>
        <!-- 轮播: while playing, a ring around the pause icon fills as the photo's turn runs out -->
        <Button x:Name="PlayButton" Classes="viewerTool" ToolTip.Tip="自动轮播（P）" Click="OnSlideshow"
                IsEnabled="{Binding CanPlay}" Classes.on="{Binding IsPlaying}">
          <Panel>
            <Ellipse Width="28" Height="28" Stroke="#26FFFFFF" StrokeThickness="2" IsVisible="{Binding IsPlaying}" />
            <Arc x:Name="PlayProgress" Width="28" Height="28" StartAngle="-90" SweepAngle="0" Stroke="#FF2E9BFF"
                 StrokeThickness="2" StrokeLineCap="Round" IsVisible="{Binding IsPlaying}" />
            <PathIcon x:Name="PlayIcon" Data="{StaticResource Icon.play}" Width="18" Height="18" />
          </Panel>
        </Button>
        <Button x:Name="IntervalButton" Classes="viewerTool interval" ToolTip.Tip="轮播间隔（[ 减慢，] 加快）" IsEnabled="{Binding CanPlay}">
          <TextBlock Text="{Binding SlideshowText}" FontSize="12" />
          <Button.Flyout>
            <services:GlassMenuFlyout Placement="Top" />
          </Button.Flyout>
        </Button>
        <Border Classes="toolDivider" />
        <Button x:Name="TagGood" Classes="viewerTool" ToolTip.Tip="标记为「好」" Click="OnTag" Tag="Good">
          <PathIcon Data="{StaticResource Icon.thumb-up-outline}" Width="18" Height="18" />
        </Button>
        <Button x:Name="TagNeutral" Classes="viewerTool" ToolTip.Tip="标记为「中」" Click="OnTag" Tag="Neutral">
          <PathIcon Data="{StaticResource Icon.emoticon-neutral-outline}" Width="18" Height="18" />
        </Button>
        <Button x:Name="TagBad" Classes="viewerTool" ToolTip.Tip="标记为「差」" Click="OnTag" Tag="Bad">
          <PathIcon Data="{StaticResource Icon.thumb-down-outline}" Width="18" Height="18" />
        </Button>
        <Border Classes="toolDivider" />
        <Button x:Name="HandButton" Classes="viewerTool" ToolTip.Tip="抓手工具（H）：拖动只移动图片，不选文字" Click="OnHandTool">
          <PathIcon Data="{StaticResource Icon.hand-back-right-outline}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="放大（+）" Click="OnZoomIn">
          <PathIcon Data="{StaticResource Icon.magnify-plus-outline}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="缩小（-）" Click="OnZoomOut">
          <PathIcon Data="{StaticResource Icon.magnify-minus-outline}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="实际大小（1）" Click="OnActualSize">
          <TextBlock Text="1:1" FontSize="13" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="适应窗口（0）" Click="OnFit">
          <PathIcon Data="{StaticResource Icon.fit-to-screen-outline}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="旋转（R）" Click="OnRotate">
          <PathIcon Data="{StaticResource Icon.rotate-left}" Width="18" Height="18" />
        </Button>
        <Button x:Name="FullScreenButton" Classes="viewerTool" ToolTip.Tip="全屏（F）" Click="OnFullScreen">
          <PathIcon x:Name="FullScreenIcon" Data="{StaticResource Icon.fullscreen}" Width="18" Height="18" />
        </Button>
        <Border Classes="toolDivider" />
        <Button Classes="viewerTool" ToolTip.Tip="图片信息（I）" Click="OnInfo" Classes.on="{Binding ShowInfo}">
          <PathIcon Data="{StaticResource Icon.information-outline}" Width="18" Height="18" />
        </Button>
        <Button x:Name="OcrButton" Classes="viewerTool" ToolTip.Tip="识别文字（T）" Click="OnOcr"
                IsVisible="{Binding OcrAvailable}" Classes.on="{Binding ShowOcr}">
          <PathIcon Data="{StaticResource Icon.text-recognition}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="预览条（B）" Click="OnFilmstrip" Classes.on="{Binding FilmstripVisible}">
          <PathIcon Data="{StaticResource Icon.filmstrip-box-multiple}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="移到废纸篓（Delete）" Click="OnDelete">
          <PathIcon Data="{StaticResource Icon.trash-can-outline}" Width="18" Height="18" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="返回缩略图（Esc）" Click="OnClose">
          <PathIcon Data="{StaticResource Icon.dots-grid}" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>

    <!-- Recognized text, in reading order; selectable, with copy-all. Slides in from the right edge: the host
         widens while the panel keeps its width (Motion.Slide). -->
    <Panel x:Name="OcrHost" Grid.Column="2" Width="0" IsVisible="False" ClipToBounds="True">
    <Border Width="300" HorizontalAlignment="Left" Background="#1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0">
      <Panel>
        <DockPanel Margin="16,44,12,16">
          <Grid x:Name="OcrHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="识别文字" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            <Button x:Name="OcrCopy" Grid.Column="1" Classes="panelTool copy" ToolTip.Tip="复制全部文字" Click="OnCopyText"
                    IsEnabled="{Binding HasOcrText}" VerticalAlignment="Center">
              <Panel>
                <PathIcon Classes="copyGlyph" Data="{StaticResource Icon.content-copy}" Width="13" Height="13" />
                <PathIcon Classes="checkGlyph" Data="{StaticResource Icon.check}" Width="15" Height="15" />
              </Panel>
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="{Binding OcrStatus}" IsVisible="{Binding OcrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="#99FFFFFF" FontSize="12" Margin="0,0,0,8" />
          <Panel>
            <ScrollViewer x:Name="OcrScroll" HorizontalScrollBarVisibility="Disabled">
              <SelectableTextBlock x:Name="OcrTextBlock" Text="{Binding OcrText}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="#E6FFFFFF" SelectionBrush="#662E9BFF" />
            </ScrollViewer>
            <!-- 复制全部: rings the text with a brief glow (Motion.Glow), drawn around the visible text only -->
            <Border x:Name="OcrGlow" Margin="-8,-6,-4,-6" CornerRadius="{StaticResource CardCornerRadius}" Opacity="0"
                    IsHitTestVisible="False" BorderThickness="1.5" BorderBrush="#B330D158" Background="#1230D158"
                    BoxShadow="0 0 18 1 #8030D158, inset 0 0 12 0 #2E30D158" VerticalAlignment="Top" />
          </Panel>
        </DockPanel>
        <!-- In the panel's top-right corner, centred in the 36px title strip (below drawn caption buttons) -->
        <Button x:Name="OcrClose" Classes="panelTool" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                ToolTip.Tip="关闭（T）" Click="OnOcr">
          <PathIcon Data="{StaticResource Icon.close}" Width="12" Height="12" />
        </Button>
      </Panel>
    </Border>
    </Panel>
  </Grid>
</Window>
