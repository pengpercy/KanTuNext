<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KanTuNext.Desktop.ViewModels"
        xmlns:views="clr-namespace:KanTuNext.Desktop.Views"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KanTuNext.Desktop.Views.ViewerWindow" x:DataType="vm:ViewerViewModel"
        Title="{Binding Title, FallbackValue=看图}" Icon="/Assets/kantunext.png"
        Width="900" Height="600" MinWidth="420" MinHeight="300"
        Background="#000000"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="Full"
        RequestedThemeVariant="Dark">
  <Window.Styles>
    <Style Selector="Button.viewerTool">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="60" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.viewerTool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.viewerTool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4DFFFFFF" />
    </Style>
    <!-- The mark the photo has: its button lights up in the accent colour -->
    <Style Selector="Button.viewerTool.on">
      <Setter Property="Foreground" Value="#FF2E9BFF" />
    </Style>
    <Style Selector="Button.viewerTool.on:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#FF5CB2FF" />
    </Style>
    <Style Selector="Border#ToolbarDock">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
      </Setter>
    </Style>
  </Window.Styles>
  <!-- macOS menu bar while viewing (the single-key shortcuts stay with the window's key handling) -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="文件">
        <NativeMenu>
          <NativeMenuItem Header="在访达中显示" Gesture="Cmd+Shift+R" Click="OnRevealMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="关闭" Gesture="Cmd+W" Click="OnCloseMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="显示">
        <NativeMenu>
          <NativeMenuItem Header="放大" Gesture="Cmd+OemPlus" Click="OnZoomInMenu" />
          <NativeMenuItem Header="缩小" Gesture="Cmd+OemMinus" Click="OnZoomOutMenu" />
          <NativeMenuItem Header="实际大小" Gesture="Cmd+D1" Click="OnActualSizeMenu" />
          <NativeMenuItem Header="适应窗口" Gesture="Cmd+D0" Click="OnFitMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="向左旋转" Gesture="Cmd+L" Click="OnRotateLeftMenu" />
          <NativeMenuItem Header="向右旋转" Gesture="Cmd+R" Click="OnRotateRightMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="照片">
        <NativeMenu>
          <NativeMenuItem Header="上一张" Gesture="Cmd+Left" IsEnabled="{Binding CanGoBack}" Click="OnPreviousMenu" />
          <NativeMenuItem Header="下一张" Gesture="Cmd+Right" IsEnabled="{Binding CanGoForward}" Click="OnNextMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="识别文字" Gesture="Cmd+T" IsEnabled="{Binding OcrAvailable}" Click="OnOcrMenu" />
          <NativeMenuItem Header="播放实况" IsEnabled="{Binding IsLivePhoto}" Click="OnPlayLiveMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="标记为「好」" Click="OnTagGoodMenu" />
          <NativeMenuItem Header="标记为「中」" Click="OnTagNeutralMenu" />
          <NativeMenuItem Header="标记为「差」" Click="OnTagBadMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="移到废纸篓" Gesture="Cmd+Back" Click="OnTrashMenu" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="窗口">
        <NativeMenu>
          <NativeMenuItem Header="最小化" Gesture="Cmd+M" Click="OnMinimizeMenu" />
          <NativeMenuItem Header="缩放" Click="OnZoomWindowMenu" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid ColumnDefinitions="*,Auto" chrome:WindowDecorationProperties.ElementRole="User">
  <Grid Grid.Column="0">
    <views:ZoomImage x:Name="Viewer" Source="{Binding Image}" Highlights="{Binding OcrBoxes}" />

    <TextBlock IsVisible="{Binding ShowError}" Text="无法打开这张图片" Foreground="#99FFFFFF" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Title strip: file name centred over a soft scrim, draggable like a title bar -->
    <Border Height="36" VerticalAlignment="Top" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#73000000" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Button IsVisible="{Binding IsLivePhoto}" Click="OnPlayLive" Padding="8,2" FontSize="11" CornerRadius="9"
                Background="#33FFFFFF" Foreground="White" BorderThickness="0" ToolTip.Tip="播放实况照片的动态部分（L）"
                chrome:WindowDecorationProperties.ElementRole="User">
          <TextBlock Text="◎ 实况" />
        </Button>
        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="White" />
        <TextBlock Text="{Binding Position}" FontSize="12" Foreground="#99FFFFFF" />
      </StackPanel>
    </Border>

    <!-- Floating toolbar, after the original: shown while the pointer moves, hidden after a short pause -->
    <Border x:Name="ToolbarDock" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
            Background="#D91C1C1E" CornerRadius="8" Padding="12,0">
      <StackPanel Orientation="Horizontal">
        <Button Classes="viewerTool" ToolTip.Tip="上一张（←）" Click="OnPrevious" IsEnabled="{Binding CanGoBack}">
          <PathIcon Data="{StaticResource Icon.menu-left-outline}" Width="30" Height="30" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="下一张（→）" Click="OnNext" IsEnabled="{Binding CanGoForward}">
          <PathIcon Data="{StaticResource Icon.menu-right-outline}" Width="30" Height="30" />
        </Button>
        <Button x:Name="TagGood" Classes="viewerTool" ToolTip.Tip="标记为「好」" Click="OnTag" Tag="Good">
          <PathIcon Data="{StaticResource Icon.thumb-up-outline}" Width="22" Height="22" />
        </Button>
        <Button x:Name="TagNeutral" Classes="viewerTool" ToolTip.Tip="标记为「中」" Click="OnTag" Tag="Neutral">
          <PathIcon Data="{StaticResource Icon.emoticon-neutral-outline}" Width="22" Height="22" />
        </Button>
        <Button x:Name="TagBad" Classes="viewerTool" ToolTip.Tip="标记为「差」" Click="OnTag" Tag="Bad">
          <PathIcon Data="{StaticResource Icon.thumb-down-outline}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="放大（+）" Click="OnZoomIn">
          <PathIcon Data="{StaticResource Icon.magnify-plus-outline}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="缩小（-）" Click="OnZoomOut">
          <PathIcon Data="{StaticResource Icon.magnify-minus-outline}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="实际大小（1）" Click="OnActualSize">
          <TextBlock Text="1:1" FontSize="16" FontWeight="Light" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="适应窗口（0）" Click="OnFit">
          <PathIcon Data="{StaticResource Icon.fit-to-screen-outline}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="旋转（R）" Click="OnRotate">
          <PathIcon Data="{StaticResource Icon.rotate-left}" Width="22" Height="22" />
        </Button>
        <Button x:Name="OcrButton" Classes="viewerTool" ToolTip.Tip="识别文字（T）" Click="OnOcr"
                IsVisible="{Binding OcrAvailable}" Classes.on="{Binding ShowOcr}">
          <PathIcon Data="{StaticResource Icon.text-recognition}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="移到废纸篓（Delete）" Click="OnDelete">
          <PathIcon Data="{StaticResource Icon.trash-can-outline}" Width="22" Height="22" />
        </Button>
        <Button Classes="viewerTool" ToolTip.Tip="返回缩略图（Esc）" Click="OnClose">
          <PathIcon Data="{StaticResource Icon.dots-grid}" Width="22" Height="22" />
        </Button>
      </StackPanel>
    </Border>
  </Grid>

    <!-- Recognized text, in reading order; selectable, with copy-all -->
    <Border Grid.Column="1" Width="300" IsVisible="{Binding ShowOcr}" Background="#1C1C1E"
            BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0">
      <DockPanel Margin="16,44,12,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Text="识别文字" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="复制全部" Click="OnCopyText" IsEnabled="{Binding HasOcrText}"
                  FontSize="12" Padding="10,4" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding OcrStatus}" IsVisible="{Binding OcrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="#99FFFFFF" FontSize="12" Margin="0,0,0,8" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock Text="{Binding OcrText}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="#E6FFFFFF" SelectionBrush="#662E9BFF" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
