<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KanTuNext.Desktop.App"
             Name="看图"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KanTuNext/Resources/Icons.axaml" />
        <ResourceInclude Source="avares://KanTuNext/Resources/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <!-- macOS application menu (other platforms use the toolbar's settings button) -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="设置…" Gesture="Cmd+OemComma" Click="OnSettingsMenu" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://KanTuNext/Resources/Styles.axaml" />
  </Application.Styles>
</Application>
