<!-- Colour tokens from the design file's 设计规范 page (design/KanTuNext.figcraft). Every key exists in both
     variants: a key missing from one makes that variant fall back to the other's value. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SidebarBrush" Color="#ECECEE" />
      <!-- Over the window's blurred backdrop. macOS: the system's sidebar material does the tinting, as in
           Finder (Services/Glass.cs). Windows: acrylic comes out bright, so a grey tint takes it down. -->
      <SolidColorBrush x:Key="SidebarTranslucentBrush" Color="#00F2F2F4" />
      <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="#47BDBDC2" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1A000000" />
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#8E8E93" />
      <SolidColorBrush x:Key="SidebarTextBrush" Color="#D9000000" />
      <SolidColorBrush x:Key="SidebarCountBrush" Color="#8E8E93" />
      <SolidColorBrush x:Key="SidebarIconBrush" Color="#007AFF" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1A000000" />
      <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#333333" />
      <SolidColorBrush x:Key="SubTextBrush" Color="#777777" />
      <SolidColorBrush x:Key="FaintBrush" Color="#C0C0C0" />
      <SolidColorBrush x:Key="ToolbarIconBrush" Color="#555555" />
      <SolidColorBrush x:Key="SegmentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="SegmentBorderBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="SearchBrush" Color="#F4F4F4" />
      <SolidColorBrush x:Key="EmptyArtBrush" Color="#BDBDBD" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0076FF" />
      <!-- Neutral input ladder (rest < hover < focus) instead of Fluent's accent focus edge -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#45000000" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7A000000" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#F4F4F4" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F4F4F4" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <!-- A light tint over the blurred menu material (Services/Glass.cs) -->
      <SolidColorBrush x:Key="MenuGlassBrush" Color="#47FFFFFF" />
      <SolidColorBrush x:Key="MenuGlassBorderBrush" Color="#1F000000" />
      <!-- Settings window: grouped cards on a slightly darker page -->
      <SolidColorBrush x:Key="SettingsPageBrush" Color="#F2F2F5" />
      <SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#12000000" />
      <SolidColorBrush x:Key="SettingsDividerBrush" Color="#14000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SidebarBrush" Color="#2C2C2E" />
      <SolidColorBrush x:Key="SidebarTranslucentBrush" Color="#00202024" />
      <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="#8C141416" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#98989D" />
      <SolidColorBrush x:Key="SidebarTextBrush" Color="#D9FFFFFF" />
      <SolidColorBrush x:Key="SidebarCountBrush" Color="#98989D" />
      <SolidColorBrush x:Key="SidebarIconBrush" Color="#0A84FF" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#000000" />
      <SolidColorBrush x:Key="PageBrush" Color="#111111" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SubTextBrush" Color="#999999" />
      <SolidColorBrush x:Key="FaintBrush" Color="#666666" />
      <SolidColorBrush x:Key="ToolbarIconBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="SegmentBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="SegmentBorderBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="SearchBrush" Color="#262626" />
      <SolidColorBrush x:Key="EmptyArtBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="AccentBrush" Color="#008FFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#52FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8CFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#262626" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2C2C2C" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E" />
      <SolidColorBrush x:Key="MenuGlassBrush" Color="#2E1C1C1E" />
      <SolidColorBrush x:Key="MenuGlassBorderBrush" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="SettingsPageBrush" Color="#1A1A1C" />
      <SolidColorBrush x:Key="SettingsCardBrush" Color="#262628" />
      <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SettingsDividerBrush" Color="#14FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <!-- One radius scale for every floating surface: panels, flyouts, menus and the viewer's dock (Panel), the
       cards inside them (Card), and their rows and small buttons (Item) -->
  <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="ItemCornerRadius">5</CornerRadius>
  <!-- Menus are tighter than panels, as the system's own -->
  <CornerRadius x:Key="MenuCornerRadius">6</CornerRadius>
  <!-- Label/value rows: one CJK font for both columns (its Latin too), so a Chinese label and a Latin-only value
       sit on the same baseline; mixed fonts place text differently within the same line height -->
  <FontFamily x:Key="InfoRowFont">PingFang SC, Microsoft YaHei UI, Noto Sans CJK SC, $Default</FontFamily>
</ResourceDictionary>
