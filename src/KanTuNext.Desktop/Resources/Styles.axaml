<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sidebar row: macOS source-list style, rounded inset selection (design: 28→32pt rows, radius 6) -->
  <Style Selector="RadioButton.sidebarItem">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="2,0,10,0" />
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.sidebarItem:pointerover /template/ Border#Row">
    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.sidebarItem:checked /template/ Border#Row">
    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
  </Style>

  <!-- Disclosure chevron inside a sidebar row: its own click target, no chrome -->
  <Style Selector="Button.chevron">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chevron:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 小/中/大/最大 segmented control -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Padding" Value="14,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Cell" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#Cell">
    <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
  </Style>

  <!-- Borderless icon button for the toolbar -->
  <Style Selector="Button.toolIcon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ToolbarIconBrush}" />
  </Style>
  <Style Selector="Button.toolIcon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
  </Style>
  <Style Selector="Button.toolIcon:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolIcon:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>

  <!-- Main-window photo info: match the translucent card over a photo in the viewer. -->
  <!-- 在地图中查看拍摄位置, under the photo details (viewer panel, 简介) -->
  <Style Selector="Button.mapLink">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="#1A2E9BFF" />
    <Setter Property="Foreground" Value="#FF5CB2FF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mapLink:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#332E9BFF" />
    <Setter Property="Foreground" Value="#FF8CC8FF" />
  </Style>
  <Style Selector="FlyoutPresenter.photoInfo">
    <Setter Property="Background" Value="#C7141416" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- Right-click menus everywhere: compact rows, smaller type and icons than Fluent's touch-friendly defaults
       (items come from Services/Menus.cs) -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="{StaticResource MenuCornerRadius}" />
  </Style>
  <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Over a blurred popup window (Services/Glass.cs): only a tint, so what's behind shows through -->
  <Style Selector="ContextMenu.glass, MenuFlyoutPresenter.glass">
    <Setter Property="Background" Value="{DynamicResource MenuGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuGlassBorderBrush}" />
  </Style>
  <!-- Windows' acrylic is thinner than macOS's menu material: a thicker tint keeps the menu as calm -->
  <Style Selector="ContextMenu.glass.windows, MenuFlyoutPresenter.glass.windows">
    <Setter Property="Background" Value="{DynamicResource MenuGlassBrushWindows}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Margin" Value="8,3" />
  </Style>

  <!-- Settings window (Views/SettingsWindow.axaml): groups of rows on cards. A row is a coloured icon tile, a
       title with an optional hint, and its control on the right; dividers start under the titles (14+26+12). -->
  <Style Selector="TextBlock.settingsHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style Selector="Grid.settingsRow">
    <Setter Property="Margin" Value="14,9" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="ColumnSpacing" Value="12" />
  </Style>
  <Style Selector="Border.settingsDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="52,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource SettingsDividerBrush}" />
  </Style>
  <Style Selector="Border.settingsIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settingsIcon PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.settingsTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.settingsHint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
  </Style>
  <!-- Switches without Fluent's 开/关 text beside them -->
  <Style Selector="ToggleSwitch.settingsSwitch">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Copy buttons: after copying, the icon gives way to a green check for a moment (Views/Motion.Copied) -->
  <Style Selector="Button.copy PathIcon">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.copy PathIcon.checkGlyph">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(0.4)" />
    <Setter Property="Foreground" Value="#30D158" />
  </Style>
  <Style Selector="Button.copy.copied PathIcon.copyGlyph">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(0.4)" />
  </Style>
  <Style Selector="Button.copy.copied PathIcon.checkGlyph">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <!-- Tooltips: even padding above and below (Fluent's 5/7 sits the text high) -->
  <Style Selector="ToolTip">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Drawn caption buttons (Windows, Linux CSD): three 46px buttons flush with the corner, as tall as the
       window's title bar (Fluent fixes them at 30 and centres them in taller bars);
       WindowChrome clears the template's spacing and insets. Keep in sync with CaptionButtonsWidth (138). -->
  <Style Selector="Button#PART_MinimizeButton, Button#PART_MaximizeButton, Button#PART_CloseButton">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Width" Value="46" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Win32 never reports AllowedWindowActions, so Avalonia 12.1 adds a full-screen button; hide it
       (12.2: use WindowDrawnDecorations.TitleBarDecorations instead). -->
  <Style Selector="Button#PART_FullScreenButton, Button#PART_PopoverFullScreenButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
</Styles>
