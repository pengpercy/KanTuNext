[Desktop Entry]
Name=看图
Name[en]=KanTuNext
Comment=离线看图与图片整理
Comment[en]=Offline image viewer and organizer
Exec=/opt/KanTuNext/KanTuNext %F
Icon=kantunext
Terminal=false
Type=Application
Categories=Graphics;Viewer;Photography;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;
StartupWMClass=kantunext
